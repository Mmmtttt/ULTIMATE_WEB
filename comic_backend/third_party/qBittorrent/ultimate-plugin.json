{
  "protocol_version": "1.0",
  "plugin": {
    "id": "download.qbittorrent",
    "name": "qBittorrent",
    "version": "0.1.0",
    "entrypoint": "./ultimate_provider.py:QbittorrentProvider",
    "config_key": "qbittorrent"
  },
  "media_types": ["video", "comic"],
  "identity": {
    "content_type": "video",
    "host_id_prefix": "QBIT",
    "platform_label": "qBittorrent",
    "aliases": ["qbittorrent", "qbit"]
  },
  "capabilities": [
    { "key": "health.query.status" },
    { "key": "download.magnet.add" },
    { "key": "download.task.status" },
    { "key": "download.task.list" },
    { "key": "download.task.pause" },
    { "key": "download.task.resume" },
    { "key": "download.task.remove" },
    { "key": "download.task.migrate" }
  ],
  "configuration": {
    "order": 80,
    "label": "qBittorrent",
    "sections": [
      {
        "id": "basic",
        "label": "基础配置",
        "fields": [
          { "key": "enabled", "label": "启用", "type": "boolean", "default": true },
          { "key": "webui_url", "label": "WebUI 地址", "type": "text", "placeholder": "http://127.0.0.1:8080" },
          { "key": "username", "label": "用户名", "type": "text", "placeholder": "qBittorrent WebUI 用户名" },
          { "key": "password", "label": "密码", "type": "password", "secret": true },
          { "key": "dir", "label": "默认下载目录", "type": "text", "placeholder": "例如 D:\\downloads 或 /downloads" },
          { "key": "timeout_seconds", "label": "请求超时秒数", "type": "number", "placeholder": "30" },
          { "key": "auto_import_enabled", "label": "下载完成后自动导入本地库", "type": "boolean", "default": false },
          { "key": "auto_import_mode", "label": "自动导入模式", "type": "text", "placeholder": "softlink_ref（软链接，保留源文件）" },
          { "key": "auto_organize_enabled", "label": "下载完成后自动归集番号文件夹", "type": "boolean", "default": false }
        ]
      }
    ]
  }
}
